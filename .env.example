# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE=your-service-role-key

NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Optional: protects /api/cron/keep-alive from being called by anyone who
# finds the URL. Vercel automatically sends this as a Bearer token when
# it triggers the cron job, if the env var is set on the Vercel project.
# Not required locally.
CRON_SECRET=
